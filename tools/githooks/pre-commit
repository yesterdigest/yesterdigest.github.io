#!/bin/sh
# index.html 이 «자산보다 낡은 채» 커밋되는 것을 막는다.
#
# 🔴 왜 있나 — 2026-09-12 커밋 8b238f6 이 assets/home.css 를 고치고 build.py 를 «안» 돌렸다.
#    index.html 은 여전히 home.css?v=37a42f49 를 가리켰고, 실제 파일은 f9fcba60 이었다.
#    판번호가 안 바뀌면 브라우저는 «옛 CSS» 를 계속 쓴다 — 고친 것이 유진님 폰에 안 간다.
#    (판번호를 넣은 계기 자체가 유진님 12:24 「웹 클릭이 아무곳도 안돼」였다.)
#
# 켜는 법 (한 번만):  git config core.hooksPath tools/githooks
set -e
cd "$(git rev-parse --show-toplevel)"
python3 build.py >/dev/null
if ! git diff --quiet -- index.html sitemap.xml; then
  echo "" >&2
  echo "  build.py 를 돌리니 아래가 바뀐다 — 자산을 고치고 다시 안 돌린 것이다." >&2
  git --no-pager diff --stat -- index.html sitemap.xml >&2
  echo "  ->  git add index.html sitemap.xml   한 뒤 다시 커밋해라." >&2
  echo "" >&2
  exit 1
fi
